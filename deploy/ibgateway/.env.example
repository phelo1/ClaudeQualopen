# Copy to .env (chmod 600). Never commit .env.
#
# Paper trading login. This is the PAPER username (Client Portal → Settings →
# Paper Trading Account; it is different from the live username) and its
# password. Start with paper; only change TRADING_MODE to live deliberately.
TWS_USERID=
# The password goes in the file ./tws_password (mode 0600), not here.
TRADING_MODE=paper

# API must be writable for qmag to place orders.
READ_ONLY_API=no

# Nightly restart keeps the session alive without a new 2FA approval
# (IBKR still forces one full re-login per week, usually Sunday).
AUTO_RESTART_TIME=11:45 PM
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
TWOFA_EXIT_INTERVAL=180

# Set a password to enable a VNC server on 127.0.0.1:5900 for looking at the
# gateway window over an SSH tunnel (ssh -L 5900:127.0.0.1:5900 ...).
VNC_SERVER_PASSWORD=

TIME_ZONE=America/New_York
JAVA_HEAP_SIZE=768
